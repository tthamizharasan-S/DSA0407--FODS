import pandas as pd
import numpy as np
from scipy import stats

drug = [12, 15, 14, 10, 13, 16, 11, 14, 15, 12,
        13, 17, 14, 11, 16, 12, 15, 13, 14, 10,
        12, 16, 13, 15, 14]

placebo = [4, 5, 3, 6, 4, 2, 5, 3, 4, 6,
           5, 4, 3, 2, 5, 4, 6, 3, 5, 4,
           2, 3, 5, 4, 6]

df = pd.DataFrame({
    'Drug': drug,
    'Placebo': placebo
})

print("Blood Pressure Reduction Data:")
print(df)

def confidence_interval(data):
    n = len(data)
    mean = np.mean(data)
    sem = stats.sem(data)

    ci = stats.t.interval(
        confidence=0.95,
        df=n-1,
        loc=mean,
        scale=sem
    )

    return mean, ci

drug_mean, drug_ci = confidence_interval(df['Drug'])

placebo_mean, placebo_ci = confidence_interval(df['Placebo'])


print("\n95% Confidence Interval Results")

print("\nNew Drug Group:")
print("Mean Reduction:", round(drug_mean, 2), "mmHg")
print("95% Confidence Interval:",
      round(drug_ci[0], 2), "to", round(drug_ci[1], 2))

print("\nPlacebo Group:")
print("Mean Reduction:", round(placebo_mean, 2), "mmHg")
print("95% Confidence Interval:",
      round(placebo_ci[0], 2), "to", round(placebo_ci[1], 2))
