import pandas as pd
sales_data = pd.DataFrame({
    'Order_Date': ['2026-09-05', '2026-09-10',
                   '2026-09-15', '2026-09-20',
                   '2026-09-25', '2026-09-28'],
    'Product': ['Laptop', 'Phone', 'Laptop',
                'Tablet', 'Phone', 'Headphones'],
    'Quantity': [10, 20, 15, 12, 8, 18]
})
sales_data['Order_Date'] = pd.to_datetime(sales_data['Order_Date'])
start_date = '2026-09-01'
end_date = '2026-09-30'
monthly_data = sales_data[
    (sales_data['Order_Date'] >= start_date) &
    (sales_data['Order_Date'] <= end_date)
]
top_products = (
    monthly_data.groupby('Product')['Quantity']
    .sum()
    .sort_values(ascending=False)
    .head(5)
)
print("Top 5 Best-Selling Products:")
print(top_products)
