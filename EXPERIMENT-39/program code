import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler
from google.colab import files


uploaded = files.upload()

file_name = next(iter(uploaded))
df = pd.read_csv(file_name)

print("Dataset:")
print(df.head())


X = df[['Total_Spent', 'Items_Purchased']]


X = X.fillna(X.mean())

scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)
df['Customer_Segment'] = kmeans.fit_predict(X_scaled)

print("\nCustomer Segmentation Results:")
print(df)

print("\nNumber of Customers in Each Segment:")
print(df['Customer_Segment'].value_counts().sort_index())


centers = scaler.inverse_transform(kmeans.cluster_centers_)

print("\nCluster Centers:")
print(pd.DataFrame(
    centers,
    columns=['Average_Total_Spent', 'Average_Items_Purchased']
))


plt.figure(figsize=(9, 6))

plt.scatter(
    df['Total_Spent'],
    df['Items_Purchased'],
    c=df['Customer_Segment'],
    cmap='viridis',
    s=70
)

plt.xlabel('Total Amount Spent')
plt.ylabel('Number of Items Purchased')
plt.title('E-commerce Customer Segmentation Using K-Means')
plt.colorbar(label='Customer Segment')
plt.grid(True)
plt.show()


df.to_csv('Customer_Segmentation_Results.csv', index=False)

print("\nResults saved successfully!")
