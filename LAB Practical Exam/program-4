import numpy as np
from scipy import stats

data = np.array([
38.9,39.1,49.7,43.5,46.1,40.1,42.3,54.3,36.6,48.0,
45.7,39.7,39.7,47.6,41.1,40.4,42.4,40.8,51.2,45.1,
50.0,45.6,48.3,50.7,43.3,46.5,46.8,47.5,57.8,47.5
])

n = int(input("Enter sample size: "))
conf = float(input("Enter confidence level: "))
precision = float(input("Enter precision: "))

sample = data[:n]

mean = np.mean(sample)
se = stats.sem(sample)

t = stats.t.ppf((1+conf/100)/2, n-1)
margin = t * se

print("\nPoint Estimation Results")
print("------------------------")
print("Point Estimate:", round(mean, 2))
print("Lower Limit:", round(mean-margin, 2))
print("Upper Limit:", round(mean+margin, 2))
print("Margin of Error:", round(margin, 2))

if margin <= precision:
    print("Desired precision achieved")
else:
    print("Desired precision not achieved")
