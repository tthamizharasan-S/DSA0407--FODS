import numpy as np
from scipy import stats

drug = np.array([
7.6,12.2,11.7,8.4,14,3.7,8.6,15.6,3.3,
13.7,13.7,17.8,11.1,17.6,18.3,10.6,11.3,
13.1,6.7,13.4,8.3,10.1,14.1,6.4,16.1
])

placebo = np.array([
4.7,1.3,4.4,5.7,-1.1,-0.3,4.9,7.7,1.4,
5.3,-1.7,1.1,3.8,11.3,5.9,7.9,-1.2,0.5,
11.5,5.6,-0.4,3.2,5.9,0.5,0.7
])

def calculate_ci(data):
    mean = np.mean(data)
    se = stats.sem(data)
    t = stats.t.ppf(0.975, len(data)-1)
    margin = t * se

    print("Mean:", round(mean, 3))
    print("Lower Limit:", round(mean-margin, 3))
    print("Upper Limit:", round(mean+margin, 3))

print("Drug Group (95% CI)")
calculate_ci(drug)

print("\nPlacebo Group (95% CI)")
calculate_ci(placebo)
