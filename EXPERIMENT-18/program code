
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from scipy import stats

data = {
    'Age': [23, 23, 27, 27, 39, 41, 47, 49, 50,
            52, 54, 54, 56, 57, 58, 58, 60, 61],

    '%Fat': [9.5, 26.5, 7.8, 17.8, 31.4, 25.9,
             27.4, 27.2, 31.2, 34.6, 42.5, 28.8,
             33.4, 30.2, 34.1, 32.9, 41.2, 35.7]
}

df = pd.DataFrame(data)

print("Dataset:")
print(df)

print("\nMean:")
print(df.mean())

print("\nMedian:")
print(df.median())

print("\nStandard Deviation:")
print(df.std())

plt.figure(figsize=(10, 5))

plt.subplot(1, 2, 1)
sns.boxplot(y=df['Age'], color='skyblue')
plt.title('Boxplot of Age')
plt.ylabel('Age')

plt.subplot(1, 2, 2)
sns.boxplot(y=df['%Fat'], color='lightgreen')
plt.title('Boxplot of Body Fat')
plt.ylabel('% Fat')

plt.tight_layout()
plt.show()

plt.figure(figsize=(7, 5))
plt.scatter(df['Age'], df['%Fat'], color='blue')

plt.title('Scatter Plot of Age vs Body Fat')
plt.xlabel('Age')
plt.ylabel('Body Fat (%)')
plt.grid(True)
plt.show()

plt.figure(figsize=(10, 5))

plt.subplot(1, 2, 1)
stats.probplot(df['Age'], dist="norm", plot=plt)
plt.title('Q-Q Plot of Age')

plt.subplot(1, 2, 2)
stats.probplot(df['%Fat'], dist="norm", plot=plt)
plt.title('Q-Q Plot of Body Fat')

plt.tight_layout()
plt.show()
